---
/**
 * ProductsSection — Halaman Product ("Products Page Desktop" node 137:1467).
 *
 *   - Heading "Premium Wrapped Bloom" Crimson Text 32 (rata tengah)
 *   - Sidebar filter: All Products, Sale, Category ▾, For Occassions ▾, Flowers ▾
 *     (item aktif "Premium Wrapped Bloom" dengan highlight sage #BBCCBF)
 *   - "Default sorting" pill + toggle grid di kanan atas
 *   - Grid produk 3×3 (menggunakan ProductCard)
 *   - Pagination "1 2 3 ... 19" (aktif #3D3B2F + underline)
 *   - Tombol WhatsApp melayang
 */
import ProductCard from './ProductCard.astro';
import productHandful from '../../assets/figma/product-handful.png';
import productBlush from '../../assets/figma/product-blush.png';
import productLove from '../../assets/figma/product-love.png';
import productVibrant from '../../assets/figma/product-vibrant.png';
import productRoseAllure from '../../assets/figma/product-roseallure.png';
import thumbBlush from '../../assets/figma/thumb-blush.png';
import thumbSunshine from '../../assets/figma/thumb-sunshine.png';
import thumbLove2 from '../../assets/figma/thumb-love2.png';
import thumbRoseAllure from '../../assets/figma/thumb-roseallure.png';

const products = [
	{
		image: productHandful,
		alt: 'A Handful Flower Box ANIA',
		category: 'Bloom Box',
		title: 'A Handful Flower Box',
		price: 'Rp 950,000',
		badge: 'Sale',
		standardThumb: productHandful,
		premiumThumb: thumbBlush,
	},
	{
		image: productBlush,
		alt: 'Blush Amethyst Orchestra ANIA',
		category: 'Premium Wrapped',
		title: 'Blush Amethyst Orchestra',
		price: 'Rp 1,250,000',
		standardThumb: productBlush,
		premiumThumb: thumbSunshine,
	},
	{
		image: productLove,
		alt: 'Love Symphony ANIA',
		category: 'Premium Wrapped',
		title: 'Love Symphony',
		price: 'Rp 700,000',
		priceOld: 'Rp 950,000',
		badge: 'Sale',
		standardThumb: productLove,
		premiumThumb: thumbLove2,
	},
	{
		image: productVibrant,
		alt: 'Vibrant Longevity ANIA',
		category: 'Vase',
		title: 'Vibrant Longevity',
		price: 'Rp 1,950,000',
	},
	{
		image: productRoseAllure,
		alt: 'Rose Allure ANIA',
		category: 'Preserved Flower',
		title: 'Rose Allure',
		price: 'Rp 1,250,000',
		standardThumb: productRoseAllure,
		premiumThumb: thumbRoseAllure,
	},
	{
		image: productBlush,
		alt: 'Blush Amethyst Orchestra ANIA',
		category: 'Premium Wrapped',
		title: 'Blush Amethyst Orchestra',
		price: 'Rp 1,250,000',
		standardThumb: productBlush,
		premiumThumb: thumbSunshine,
	},
	{
		image: productHandful,
		alt: 'A Handful Flower Box ANIA',
		category: 'Bloom Box',
		title: 'A Handful Flower Box',
		price: 'Rp 950,000',
		badge: 'Sale',
		standardThumb: productHandful,
		premiumThumb: thumbBlush,
	},
	{
		image: productBlush,
		alt: 'Blush Amethyst Orchestra ANIA',
		category: 'Premium Wrapped',
		title: 'Blush Amethyst Orchestra',
		price: 'Rp 1,250,000',
		standardThumb: productBlush,
		premiumThumb: thumbSunshine,
	},
	{
		image: productLove,
		alt: 'Love Symphony ANIA',
		category: 'Premium Wrapped',
		title: 'Love Symphony',
		price: 'Rp 700,000',
		priceOld: 'Rp 950,000',
		badge: 'Sale',
		standardThumb: productLove,
		premiumThumb: thumbLove2,
	},
];

const categories = [
	'Bloom Box & Basket',
	'Premium Wrapped Bloom',
	'Standing Flower & Flower Board',
	'Preserved Flower',
	'Vase Arrangement',
	'Accessories',
];

const occasions = [
	'Anniversary',
	'Birthday',
	'Graduation',
	'Newborn',
	'Congratulations',
	'Wedding',
	'Get Well Soon',
	'Condolences',
	'Corporate',
	'Seasonal',
	'Just Because',
];

const flowers = ['Rose', 'Carnation', 'Daisy', 'Hydrangea', 'Chrysanthemum', 'Sunflower', 'Orchid'];
---

<section class="bg-[#FDF6F1]">
	<div class="mx-auto w-full max-w-[1440px] px-4 sm:px-6 lg:px-[50px]">
		<!-- Heading + sort -->
		<div class="relative pt-10">
			<h1 class="text-center font-['Crimson_Text'] text-3xl font-normal text-[#1E2934] lg:text-[32px]">
				Premium Wrapped Bloom
			</h1>

			<div class="mt-6 flex items-center justify-between gap-4 lg:absolute lg:right-0 lg:top-10 lg:mt-0">
				<button
					type="button"
					class="flex h-[29px] cursor-pointer items-center gap-2 rounded-full border border-[#EAE8E8] bg-transparent px-4 text-xs font-normal text-black"
				>
					Default sorting
					<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#3D3B2F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<button
					type="button"
					aria-label="Tampilan grid"
					class="flex h-6 w-6 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-[#3D3B2F]"
				>
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" />
						<rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" />
						<rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" />
						<rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" />
					</svg>
				</button>
			</div>
		</div>

		<!-- Sidebar + grid -->
		<div class="mt-8 flex flex-col gap-8 lg:mt-12 lg:flex-row lg:gap-5">
			<!-- Sidebar filter -->
			<aside class="w-full shrink-0 lg:w-[320px]">
				<div class="hidden flex-col lg:flex">
					<button type="button" class="flex items-center gap-2 border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
						All Products
					</button>
					<span class="mt-3 h-px w-full bg-[#CCC8A8]"></span>

					<button type="button" class="mt-3 flex items-center gap-2 border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
						Sale
					</button>
					<span class="mt-3 h-px w-full bg-[#CCC8A8]"></span>

					<div class="mt-3">
						<button type="button" class="flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
							Category
							<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
								<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<ul class="mt-2 flex flex-col">
							{categories.map((c, i) => (
								<li class={`flex items-center gap-2 text-base tracking-[-0.8px] ${i === 1 ? 'bg-[#BBCCBF] px-2 font-semibold text-[#525252]' : 'px-2 py-[3px] text-[#6D6D6D]'}`}>
									<span class={`text-base leading-5 ${i === 1 ? 'text-[#525252]' : 'text-[#3D3B2F]'}`}>•</span>
									<span class="py-[3px]">{c}</span>
								</li>
							))}
						</ul>
					</div>
					<span class="mt-2 h-px w-full bg-[#CCC8A8]"></span>

					<div class="mt-3">
						<button type="button" class="flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
							For Occassions
							<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
								<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<ul class="mt-2 flex flex-col">
							{occasions.map((o) => (
								<li class="flex items-center gap-2 px-2 py-[3px] text-base tracking-[-0.8px] text-[#6D6D6D]">
									<span class="text-[#7E4C4C]">•</span>
									<span>{o}</span>
								</li>
							))}
						</ul>
					</div>
					<span class="mt-2 h-px w-full bg-[#CCC8A8]"></span>

					<div class="mt-3">
						<button type="button" class="flex w-full items-center justify-between border-0 bg-transparent p-0 text-left text-base font-normal tracking-[-0.8px] text-[#6D6D6D]">
							Flowers
							<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
								<path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<ul class="mt-2 flex flex-col">
							{flowers.map((f) => (
								<li class="flex items-center gap-2 px-2 py-[3px] text-base tracking-[-0.8px] text-[#6D6D6D]">
									<span class="text-[#7E4C4C]">•</span>
									<span>{f}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			</aside>

			<!-- Grid produk -->
			<div class="flex-1">
				<div class="grid grid-cols-1 gap-x-5 gap-y-12 sm:grid-cols-2 xl:grid-cols-3">
					{products.map((p) => (
						<ProductCard {...p} />
					))}
				</div>
			</div>
		</div>


		<!-- Pagination -->
		<div class="relative mt-14 pb-8">
			<div class="flex items-center justify-center gap-5 text-[10px] font-normal text-[#6D6D6D]/50">
				<span class="relative font-bold text-[#3D3B2F]">
					1
					<span class="absolute -bottom-1 left-1/2 h-[2px] w-5 -translate-x-1/2 bg-[#3D3B2F]"></span>
				</span>
				<span>2</span>
				<span>3</span>
				<span>...</span>
				<span>19</span>
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="m6 4 4 4-4 4" stroke="#D0D0D0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</div>
			<span class="absolute -bottom-0.5 left-0 h-px w-full bg-[#CCC8A8]"></span>
		</div>
	</div>

	<!-- WhatsApp float -->
	<a
		href="https://wa.me/"
		target="_blank"
		rel="noopener"
		aria-label="Chat WhatsApp"
		class="fixed bottom-6 right-6 z-40 flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-[0_8px_24px_rgba(0,0,0,0.18)] transition-transform duration-200 hover:scale-105"
	>
		<svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path
				d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
				fill="#22CE5A"
			/>
		</svg>
	</a>
</section>
